# NexusMind environment configuration.
# Copy to .env and adjust. Never commit .env.

# LLM endpoint (OpenAI-compatible). Point at Ollama or vLLM.
NEXUSMIND_LLM_BASE_URL=http://localhost:11434/v1
NEXUSMIND_LLM_MODEL=qwen2.5:14b-instruct

# Embeddings
NEXUSMIND_EMBED_MODEL=bge-m3

# Reranker (cross-encoder; optional, CPU-friendly)
NEXUSMIND_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Stores
# Qdrant server URL; leave empty for the embedded numpy backend.
NEXUSMIND_QDRANT_URL=
NEXUSMIND_KUZU_PATH=./data/graph
NEXUSMIND_REDIS_URL=redis://localhost:6379/0

# Local state
NEXUSMIND_DATA_DIR=./data

# Production requires an API key (API refuses non-loopback without it).
NEXUSMIND_API_KEY=

# Sampling / context
NEXUSMIND_MAX_CONTEXT_TOKENS=32768
NEXUSMIND_TEMPERATURE=0.2

# Logging: DEBUG | INFO | WARNING | ERROR
NEXUSMIND_LOG_LEVEL=INFO

# Optional tracing (Langfuse)
NEXUSMIND_LANGFUSE_KEY=